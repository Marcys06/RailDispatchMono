{
  "project": "RailDispatchMono",
  "defaultBranch": "master",
  "coreProject": "RailDispatchMono/RailDispatchMono.Core",
  "targetFramework": "net9.0",
  "engine": "MonoGame",
  "runtime": {
    "gameClass": "RailDispatchMono.Core.RailDispatchMonoGame",
    "screenManager": "RailDispatchMono.Core.ScreenManagers.ScreenManager",
    "screenBase": "RailDispatchMono.Core.Screens.GameScreen",
    "fixedTimestep": true,
    "targetFps": 60,
    "preferredBackbuffer": "1280x720",
    "logicalPresentationSize": "800x480"
  },
  "responsibilities": {
    "RailDispatchMonoGame": ["graphics configuration", "game initialization", "top-level update delegation", "top-level draw delegation"],
    "ScreenManager": ["screen collection", "screen lifecycle", "input routing", "shared drawing resources", "presentation scaling", "touch gesture configuration"],
    "GameScreen": ["screen lifecycle state", "transitions", "screen-specific update", "screen-specific input", "screen-specific draw"],
    "InputState": ["keyboard state", "gamepad state", "mouse state", "touch state", "gesture queue", "logical cursor", "semantic input actions"],
    "RailDispatchMonoSettings": ["fullscreen setting", "language setting", "particle effect setting", "property change notification"]
  },
  "rules": [
    "Core is shared by platform hosts.",
    "Use ScreenManager for screen registration, removal and input routing.",
    "Use InputState for shared input semantics and logical cursor coordinates.",
    "Keep domain state out of presentation-only screens.",
    "Search call sites before changing shared APIs.",
    "Do not delete existing files during additive documentation work."
  ]
}

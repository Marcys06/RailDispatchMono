<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Arial</FontName>
    <Size>24</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    
    <!-- ✅ Dodaj domyślny znak -->
    <DefaultCharacter>?</DefaultCharacter>
    
    <CharacterRegions>
      <!-- ✅ Rozszerz zakres o polskie znaki -->
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#255;</End>  <!-- Zmień z 126 na 255 -->
      </CharacterRegion>
      
      <!-- ✅ Lub dodaj osobne regiony dla polskich znaków -->
      <CharacterRegion>
        <Start>&#260;</Start>  <!-- Ą -->
        <End>&#380;</End>      <!-- Ż - cały zakres polskich znaków -->
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
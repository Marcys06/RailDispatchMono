<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Roboto-Bold</FontName>
    <Size>14</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>

    <!-- Domyślny znak dla brakujących glifów -->
    <DefaultCharacter>?</DefaultCharacter>

    <CharacterRegions>
      <!-- Podstawowy zestaw znaków (spacja do ~) -->
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>

      <!-- Alfabet łaciński z polskimi znakami -->
      <CharacterRegion>
        <Start>&#192;</Start>
        <End>&#255;</End>
      </CharacterRegion>

      <!-- Polskie znaki specjalne -->
      <CharacterRegion>
        <Start>&#260;</Start>  <!-- Ą -->
        <End>&#261;</End>     <!-- ą -->
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#262;</Start>  <!-- Ć -->
        <End>&#263;</End>     <!-- ć -->
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#280;</Start>  <!-- Ę -->
        <End>&#281;</End>     <!-- ę -->
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#321;</Start>  <!-- Ł -->
        <End>&#322;</End>     <!-- ł -->
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#323;</Start>  <!-- Ń -->
        <End>&#324;</End>     <!-- ń -->
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#211;</Start>  <!-- Ó -->
        <End>&#243;</End>     <!-- ó -->
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#346;</Start>  <!-- Ś -->
        <End>&#347;</End>     <!-- ś -->
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#377;</Start>  <!-- Ź -->
        <End>&#378;</End>     <!-- ź -->
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#379;</Start>  <!-- Ż -->
        <End>&#380;</End>     <!-- ż -->
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>